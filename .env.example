# 9router endpoint (public router or local http://localhost:20128/v1)
BASE_URL=https://router.atcgroup.cc/v1
MODEL=cx/gpt-5.5
# API key for the router. Do NOT commit a real key or ship it in a public build —
# enter it in the app's "API Key" field, or keep it in this local .env only.
API_KEY=sk-xxxxxxxx

# Agent loop
MAX_STEPS=15
MAX_TOKENS=4000
STEP_DELAY_MS=400
MODEL_IMAGE_WIDTH=1280

# desktop | android
TARGET=desktop

# Desktop coordinate space that the OS mouse API expects.
# mac (Retina) -> logical ; Windows @100% scale -> logical works too.
# If clicks land offset, try: physical
COORD_SPACE=logical

# Android (only if TARGET=android). Leave blank to use the only connected device.
ANDROID_SERIAL=
ADB_PATH=adb
